{% extends 'base.html.twig' %}

{% block title %}Match en cours{% endblock %}

{% block body %}
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background: #050810;
        min-height: 100vh;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: #e2e8f0;
        overflow: hidden;
    }

    .hidden { display: none !important; }

    .arena-bg {
        position: fixed; inset: 0;
        background-image: url('/images/arena.png');
        background-size: cover;
        background-position: center;
        opacity: 0.3;
        z-index: 0;
    }
    .arena-overlay {
        position: fixed; inset: 0;
        background: linear-gradient(to bottom, rgba(5,8,16,0.6) 0%, rgba(5,8,16,0.2) 40%, rgba(5,8,16,0.2) 60%, rgba(5,8,16,0.97) 100%);
        z-index: 0;
    }

    .app-container {
        position: relative; z-index: 1;
        height: 100vh;
        display: flex; flex-direction: column;
        padding: 14px 16px 12px;
        gap: 12px;
    }

    .team-card {
        flex: 1;
        border-radius: 22px;
        padding: 18px 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        position: relative;
        overflow: hidden;
    }
    .team-card.team1 {
        background: linear-gradient(145deg, rgba(220,38,38,0.3) 0%, rgba(127,29,29,0.15) 100%);
        border: 1px solid rgba(248,113,113,0.25);
        box-shadow: 0 0 40px rgba(220,38,38,0.12), inset 0 0 60px rgba(220,38,38,0.04);
    }
    .team-card.team2 {
        background: linear-gradient(145deg, rgba(37,99,235,0.3) 0%, rgba(29,78,216,0.15) 100%);
        border: 1px solid rgba(96,165,250,0.25);
        box-shadow: 0 0 40px rgba(37,99,235,0.12), inset 0 0 60px rgba(37,99,235,0.04);
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
    }
    .team-icon {
        width: 48px; height: 48px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }
    .team1 .team-icon {
        background: radial-gradient(circle, rgba(248,113,113,0.25), rgba(220,38,38,0.1));
        border: 2px solid rgba(248,113,113,0.35);
        box-shadow: 0 0 16px rgba(248,113,113,0.3);
    }
    .team2 .team-icon {
        background: radial-gradient(circle, rgba(96,165,250,0.25), rgba(37,99,235,0.1));
        border: 2px solid rgba(96,165,250,0.35);
        box-shadow: 0 0 16px rgba(96,165,250,0.3);
    }
    .card-header-text { flex: 1; }
    .team-name {
        font-size: 17px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .team1 .team-name { color: #fca5a5; }
    .team2 .team-name { color: #93c5fd; }
    .team-underline {
        width: 36px; height: 3px;
        border-radius: 2px;
        margin-top: 5px;
    }
    .team1 .team-underline { background: #f87171; box-shadow: 0 0 8px #f87171; }
    .team2 .team-underline { background: #60a5fa; box-shadow: 0 0 8px #60a5fa; }

    .score-inner {
        width: 100%;
        border-radius: 16px;
        padding: 16px 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1;
    }
    .team1 .score-inner {
        background: rgba(0,0,0,0.35);
        border: 1px solid rgba(248,113,113,0.15);
    }
    .team2 .score-inner {
        background: rgba(0,0,0,0.35);
        border: 1px solid rgba(96,165,250,0.15);
    }
    .team-score {
        font-size: 90px;
        font-weight: 900;
        line-height: 1;
        letter-spacing: -3px;
    }
    .team1 .team-score {
        color: #f87171;
        text-shadow: 0 0 40px rgba(248,113,113,0.7), 0 0 80px rgba(248,113,113,0.3);
    }
    .team2 .team-score {
        color: #60a5fa;
        text-shadow: 0 0 40px rgba(96,165,250,0.7), 0 0 80px rgba(96,165,250,0.3);
    }

    .btn-plus {
        width: 72px; height: 72px;
        border-radius: 50%;
        border: none;
        cursor: pointer;
        font-size: 22px;
        font-weight: 900;
        color: white;
        transition: all 0.15s;
        backdrop-filter: blur(8px);
    }
    .team1 .btn-plus {
        background: radial-gradient(circle at 40% 35%, rgba(248,113,113,0.85), rgba(220,38,38,0.7));
        box-shadow: 0 0 30px rgba(248,113,113,0.5), 0 0 60px rgba(248,113,113,0.2), inset 0 1px 0 rgba(255,255,255,0.2);
    }
    .team2 .btn-plus {
        background: radial-gradient(circle at 40% 35%, rgba(96,165,250,0.85), rgba(37,99,235,0.7));
        box-shadow: 0 0 30px rgba(96,165,250,0.5), 0 0 60px rgba(96,165,250,0.2), inset 0 1px 0 rgba(255,255,255,0.2);
    }
    .btn-plus:active { transform: scale(0.93); }

    .center-panel {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        flex-shrink: 0;
        width: 180px;
    }
    .manche-box {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 14px;
        padding: 6px 18px;
        text-align: center;
        white-space: nowrap;
    }
    .service-ball {
        width: 68px; height: 68px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 34px;
        background: rgba(255,255,255,0.05);
        border: 2px solid rgba(255,255,255,0.15);
        transition: all 0.3s;
    }
    .service-ball.team1-service {
        border-color: #f87171;
        box-shadow: 0 0 25px rgba(248,113,113,0.5), 0 0 50px rgba(248,113,113,0.2);
    }
    .service-ball.team2-service {
        border-color: #60a5fa;
        box-shadow: 0 0 25px rgba(96,165,250,0.5), 0 0 50px rgba(96,165,250,0.2);
    }

    .action-bar {
        background: rgba(8,13,26,0.9);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 18px;
        padding: 10px 20px;
        display: flex;
        align-items: center;
        justify-content: space-around;
        backdrop-filter: blur(12px);
        flex-shrink: 0;
    }
    .btn-action {
        display: flex; flex-direction: column; align-items: center;
        gap: 5px;
        background: none; border: none;
        cursor: pointer;
        color: #ffffff;
        font-size: 11px; font-weight: 500;
        transition: color 0.2s;
        padding: 4px 10px;
    }
    .btn-action:hover { color: #e2e8f0; opacity: 0.8; }
    .btn-action:active { color: #a78bfa; }
    .action-divider {
        width: 1px; height: 28px;
        background: rgba(255,255,255,0.08);
    }

    .modal-backdrop {
        position: fixed; inset: 0;
        background: rgba(5,8,16,0.88);
        display: flex; align-items: center; justify-content: center;
        z-index: 50;
        backdrop-filter: blur(6px);
    }
    .modal-card {
        background: linear-gradient(135deg, #0d1b35, #070c18);
        border-radius: 24px;
        padding: 28px;
        width: 90%;
        max-width: 320px;
        border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 25px 60px rgba(0,0,0,0.6);
    }
    .modal-btn {
        width: 100%; padding: 14px; border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.06);
        color: #e2e8f0; font-size: 14px; font-weight: 600;
        cursor: pointer; transition: all 0.15s; text-align: center;
    }
    .modal-btn:hover { background: rgba(255,255,255,0.12); }
    .modal-btn:active { transform: scale(0.98); }
    .modal-btn-cancel {
        width: 100%; padding: 11px; border-radius: 12px;
        border: none; background: rgba(255,255,255,0.03);
        color: #475569; font-size: 13px; cursor: pointer; margin-top: 12px;
    }
    .modal-btn-cancel:hover { color: #94a3b8; }
    .player-btn {
        padding: 12px 8px; border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.05);
        color: #e2e8f0; font-size: 12px; font-weight: 600;
        cursor: pointer; transition: all 0.15s; width: 100%;
    }
    .player-btn:hover { background: rgba(167,139,250,0.2); border-color: #a78bfa; }
    .sheet-slide {
        position: fixed; inset: 0;
        background: rgba(5,8,16,0.88);
        z-index: 50; display: flex; align-items: flex-end;
        backdrop-filter: blur(6px);
    }
    .sheet-content {
        background: linear-gradient(135deg, #0d1b35, #070c18);
        width: 100%; border-radius: 24px 24px 0 0;
        padding: 24px; max-height: 80vh; overflow-y: auto;
        border-top: 1px solid rgba(255,255,255,0.1);
    }

    /* ── MOBILE PORTRAIT ── */
    @media (max-width: 768px) and (orientation: portrait) {
        body { overflow: auto !important; }
        header button { display: none !important; }
        .app-container {
            height: auto !important;
            min-height: 100vh !important;
            overflow: visible !important;
            padding-bottom: 80px !important;
        }

        main {
        flex-direction: column !important;
        align-items: stretch !important;
        justify-content: flex-start !important;
        gap: 10px !important;
        overflow: visible !important;
        }

        header {
            flex-wrap: nowrap !important;
            gap: 6px !important;
        }
        header > div:first-child { display: none !important; }
header button { display: none !important; }
header > div:nth-child(2) {
    width: 100% !important;
    justify-content: center !important;
}
        header > div:nth-child(2) span {
            font-size: 12px !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            max-width: 70px !important;
        }

        .team-card {
            height: auto !important;
            flex-direction: column !important;
            padding: 16px !important;
            gap: 12px !important;
            flex: 0 0 auto !important;
        }
        .team-card .score-inner {
            flex: 0 !important;
            padding: 12px !important;
        }
        .team-score { font-size: 72px !important; }

        .btn-plus {
            width: 100% !important;
            height: 52px !important;
            border-radius: 14px !important;
            font-size: 20px !important;
        }

        #center-panel {
            flex-direction: column !important;
            width: 100% !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 12px !important;
        }
        .center-panel {
            flex-direction: row !important;
            justify-content: center !important;
            align-items: center !important;
            gap: 16px !important;
            flex: 0 0 auto !important;
            padding: 8px 0 !important;
            width: 100% !important;
        }
        .manche-box { padding: 6px 14px !important; }
        .manche-box p:last-child { font-size: 24px !important; }
        .service-ball {
            width: 56px !important;
            height: 56px !important;
            font-size: 28px !important;
        }

        .action-bar {
            position: fixed !important;
            bottom: 0 !important;
            left: 0 !important;
            right: 0 !important;
            border-radius: 0 !important;
            z-index: 40 !important;
        }
    }

    /* ── MOBILE LANDSCAPE ── */
    @media (max-width: 900px) and (orientation: landscape) {
        body { overflow: hidden !important; }
                
        .app-container {
        height: 100vh !important;
        min-height: unset !important;
        overflow: hidden !important;
        padding: 6px 12px 6px !important;
        gap: 4px !important;
        display: flex !important;
        flex-direction: column !important;
        }
        header {
            height: 40px !important;
            flex-shrink: 0 !important;
            padding: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        header > div:first-child { display: none !important; }
        header button { display: none !important; }
        header > div:nth-child(2) {
            width: 100% !important;
            justify-content: center !important;
            display: flex !important;
        }
        main {
        flex: 1 !important;
        min-height: 0 !important;
        }

        .team-card {
            height: 100% !important;
            flex-direction: column !important;
            padding: 10px !important;
            gap: 6px !important;
            flex: 1 !important;
        }
        .team-card .score-inner {
            flex: 1 !important;
            padding: 6px !important;
        }
        .team-score { font-size: 55px !important; }
        .team-name { font-size: 13px !important; }
        .team-icon {
            width: 32px !important;
            height: 32px !important;
            font-size: 16px !important;
        }

        .btn-plus {
            width: 100% !important;
            height: 36px !important;
            border-radius: 10px !important;
            font-size: 15px !important;
        }

        #center-panel {
            flex-direction: column !important;
            width: 130px !important;
            gap: 8px !important;
            flex-shrink: 0 !important;
        }
        .manche-box { padding: 4px 12px !important; }
        .manche-box p:first-child { font-size: 8px !important; }
        .manche-box p:last-child { font-size: 22px !important; }
        .service-ball {
            width: 46px !important;
            height: 46px !important;
            font-size: 22px !important;
        }

        .action-bar {
            position: relative !important;
            bottom: unset !important;
            border-radius: 12px !important;
            padding: 6px 12px !important;
            flex-shrink: 0 !important;
        }
        .btn-action {
            font-size: 10px !important;
            gap: 2px !important;
            padding: 2px 6px !important;
        }
        .btn-action svg {
            width: 18px !important;
            height: 18px !important;
        }
        .action-divider { height: 20px !important; }
    }
</style>

<div class="arena-bg"></div>
<div class="arena-overlay"></div>

<div class="app-container">

    {# ── HEADER ── #}
    <header style="display: flex; align-items: center; justify-content: space-between;">

        <div style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 38px; height: 38px; background: radial-gradient(circle, #f87171, #dc2626); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 0 15px rgba(248,113,113,0.5);">🏐</div>
            <span style="font-size: 20px; font-weight: 900; letter-spacing: -0.5px;">My<span style="color: #60a5fa;">Volley</span></span>
        </div>

        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 16px; font-weight: 700; color: #fca5a5;">{{ team1.name }}</span>
<div style="display: flex; align-items: center; gap: 10px;">
    <span style="font-size: 28px; font-weight: 900; color: #f87171;" id="sets-team1">{{ setsTeam1 }}</span>
    <span style="font-size: 18px; color: #334155;">—</span>
    <span style="font-size: 28px; font-weight: 900; color: #60a5fa;" id="sets-team2">{{ setsTeam2 }}</span>
</div>
<span style="font-size: 16px; font-weight: 700; color: #93c5fd;">{{ team2.name }}</span>
        </div>

        <button onclick="endMatch()" style="padding: 9px 16px; border-radius: 10px; background: linear-gradient(135deg, #dc2626, #991b1b); border: none; color: white; font-size: 12px; font-weight: 700; cursor: pointer; box-shadow: 0 0 15px rgba(220,38,38,0.4);">
            🏁 Terminer
        </button>

    </header>


    {# ── ZONE DE JEU ── #}
    <main style="flex: 1; display: flex; align-items: center; gap: 14px; overflow: hidden;">

        {# Équipe 1 #}
        <div class="team-card team1" style="height: 80%;">
            <div class="card-header">
                <div class="team-icon">🏐</div>
                <div class="card-header-text">
                    <p class="team-name">{{ team1.name }}</p>
                    <div class="team-underline"></div>
                </div>
            </div>
            <div class="score-inner">
                <p class="team-score" id="score-team1">{{ currentManche.scoreTeam1 }}</p>
            </div>
            <button class="btn-plus" onclick="openModal(1)">+1</button>
        </div>


            {# Centre : manche + service horizontal #}
            <div id="center-panel" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; flex-shrink: 0; width: 180px;">

            <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 16px; padding: 8px 20px; text-align: center;">
                <p style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.15em; color: #ffffff; margin-bottom: 2px;">Manche</p>
                <p style="font-size: 36px; font-weight: 900; color: #e2e8f0;" id="manche-number">{{ currentManche.number }}</p>
            </div>

            <div style="display: flex; align-items: center; gap: 12px;">
                <span id="arrow-left" style="font-size: 20px; color: #f87171; opacity: 0; transition: opacity 0.3s;">◀</span>
                <div class="service-ball" id="service-ball">🏐</div>
                <span id="arrow-right" style="font-size: 20px; color: #60a5fa; opacity: 0; transition: opacity 0.3s;">▶</span>
            </div>

            <div style="text-align: center;">
                <p style="font-size: 10px; color: #ffffff; text-transform: uppercase; letter-spacing: 0.1em;">Service</p>
                <p style="font-size: 13px; font-weight: 700; margin-top: 4px;" id="service-label">—</p>
            </div>

            </div>


        {# Équipe 2 #}
        <div class="team-card team2" style="height: 80%;">
            <div class="card-header" style="flex-direction: row-reverse; text-align: right;">
                <div class="team-icon">🏐</div>
                <div class="card-header-text" style="text-align: right;">
                    <p class="team-name">{{ team2.name }}</p>
                    <div class="team-underline" style="margin-left: auto; margin-right: 0;"></div>
                </div>
            </div>
            <div class="score-inner">
                <p class="team-score" id="score-team2">{{ currentManche.scoreTeam2 }}</p>
            </div>
            <button class="btn-plus" onclick="openModal(2)">+1</button>
        </div>

    </main>


    {# ── BARRE D'ACTIONS ── #}
    <div class="action-bar">
        <button class="btn-action" onclick="rollback()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" /></svg>
            Annuler
        </button>
        <div class="action-divider"></div>
        <button class="btn-action" onclick="openSubstitution()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" /></svg>
            Remplacer
        </button>
        <div class="action-divider"></div>
        <button class="btn-action" onclick="openPositions()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" /></svg>
            Positions
        </button>
        <div class="action-divider"></div>
        <button class="btn-action" onclick="openStats()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>
            Stats
        </button>
        <div class="action-divider"></div>
        <button class="btn-action" onclick="openMenu()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
            Menu
        </button>
    </div>

</div>


{# ── MODAL SERVICE ── #}
<div id="modal-service" class="modal-backdrop {{ game.serviceTeam ? 'hidden' : '' }}">
    <div class="modal-card">
        <h2 style="font-size: 17px; font-weight: 700; text-align: center; margin-bottom: 6px;">Qui commence le service ?</h2>
        <p style="font-size: 13px; color: #64748b; text-align: center; margin-bottom: 20px;">Sélectionne l'équipe qui sert en premier</p>
        <div style="display: flex; flex-direction: column; gap: 10px;">
            <button class="modal-btn" style="color: #f87171; border-color: rgba(248,113,113,0.3);" onclick="setService({{ team1.id }})">🏐 {{ team1.name }}</button>
            <button class="modal-btn" style="color: #60a5fa; border-color: rgba(96,165,250,0.3);" onclick="setService({{ team2.id }})">🏐 {{ team2.name }}</button>
        </div>
    </div>
</div>


{# ── MODAL POINT ── #}
<div id="modal-point" class="modal-backdrop hidden">
    <div class="modal-card">
        <h2 style="font-size: 17px; font-weight: 700; text-align: center; margin-bottom: 20px;" id="modal-title">Type de point</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;" id="step-type">
            <button class="modal-btn" onclick="selectType('ace')">🎯 Ace</button>
            <button class="modal-btn" onclick="selectType('attack')">⚡ Attaque</button>
            <button class="modal-btn" onclick="selectType('block')">🛡️ Block</button>
            <button class="modal-btn" onclick="selectType('fault')">❌ Faute</button>
        </div>
        <div id="step-player" class="hidden">
            <p style="font-size: 13px; color: #64748b; text-align: center; margin-bottom: 12px;">Qui a marqué ?</p>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" id="players-list"></div>
        </div>
        <button class="modal-btn-cancel" onclick="closeModal()">Annuler</button>
    </div>
</div>


{# ── MODAL REMPLACEMENT ── #}
<div id="modal-substitution" class="modal-backdrop hidden">
    <div class="modal-card">
        <h2 style="font-size: 17px; font-weight: 700; text-align: center; margin-bottom: 20px;" id="sub-title">Remplacement</h2>
        <div id="sub-step-team">
            <p style="font-size: 13px; color: #64748b; text-align: center; margin-bottom: 12px;">Quelle équipe ?</p>
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <button class="modal-btn" style="color: #f87171;" onclick="subSelectTeam(1)">{{ team1.name }}</button>
                <button class="modal-btn" style="color: #60a5fa;" onclick="subSelectTeam(2)">{{ team2.name }}</button>
            </div>
        </div>
        <div id="sub-step-out" class="hidden">
            <p style="font-size: 13px; color: #64748b; text-align: center; margin-bottom: 12px;">Joueur qui sort ?</p>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" id="sub-players-out"></div>
        </div>
        <div id="sub-step-in" class="hidden">
            <p style="font-size: 13px; color: #64748b; text-align: center; margin-bottom: 12px;">Joueur qui entre ?</p>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;" id="sub-players-in"></div>
        </div>
        <button class="modal-btn-cancel" onclick="closeSubstitution()">Annuler</button>
    </div>
</div>


{# ── LAYER STATS ── #}
<div id="layer-stats" class="sheet-slide hidden">
    <div class="sheet-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="font-size: 17px; font-weight: 700;">Statistiques</h2>
            <button onclick="closeStats()" style="background: none; border: none; color: #64748b; font-size: 22px; cursor: pointer;">×</button>
        </div>
        <div id="stats-content"><p style="color: #475569; text-align: center; padding: 32px 0;">Chargement...</p></div>
    </div>
</div>


{# ── MODAL POSITIONS ── #}
<div id="modal-positions" class="sheet-slide hidden">
    <div class="sheet-content" style="max-height: 95vh;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <h2 style="font-size: 17px; font-weight: 700;">Positions</h2>
            <button onclick="closePositions()" style="background: none; border: none; color: #64748b; font-size: 22px; cursor: pointer;">×</button>
        </div>
        <div id="terrain-container" style="position: relative; width: 100%; max-width: 560px; margin: 0 auto;">
            <svg viewBox="0 0 560 320" xmlns="http://www.w3.org/2000/svg" style="width: 100%; border-radius: 12px;">
                <rect width="560" height="320" rx="12" fill="#c47a2b"/>
                <rect x="20" y="20" width="520" height="280" fill="none" stroke="white" stroke-width="2"/>
                <line x1="280" y1="10" x2="280" y2="310" stroke="white" stroke-width="3"/>
                <line x1="107" y1="20" x2="107" y2="300" stroke="white" stroke-width="1" stroke-dasharray="6,4"/>
                <line x1="453" y1="20" x2="453" y2="300" stroke="white" stroke-width="1" stroke-dasharray="6,4"/>
                <rect width="560" height="320" rx="12" fill="none" stroke="#0d9488" stroke-width="8"/>
            </svg>
            <div id="positions-team1" style="position: absolute; inset: 0;"></div>
            <div id="positions-team2" style="position: absolute; inset: 0;"></div>
        </div>
        <div style="display: flex; justify-content: center; gap: 24px; margin-top: 16px;">
            <div style="display: flex; align-items: center; gap: 6px;"><div style="width: 12px; height: 12px; border-radius: 50%; background: #f87171;"></div><span style="font-size: 12px; color: #94a3b8;">{{ team1.name }}</span></div>
            <div style="display: flex; align-items: center; gap: 6px;"><div style="width: 12px; height: 12px; border-radius: 50%; background: #60a5fa;"></div><span style="font-size: 12px; color: #94a3b8;">{{ team2.name }}</span></div>
        </div>
    </div>
</div>


{# ── MODAL FIN DE MATCH ── #}
<div id="modal-end-game" class="modal-backdrop hidden">
    <div class="modal-card" style="text-align: center;">
        <div style="font-size: 48px; margin-bottom: 12px;">🏆</div>
        <h2 style="font-size: 22px; font-weight: 900; margin-bottom: 4px; color: #fbbf24;" id="end-winner-name">Équipe</h2>
        <p style="font-size: 13px; color: #64748b; margin-bottom: 20px;">remporte le match !</p>
        <div style="display: flex; justify-content: center; gap: 24px; margin-bottom: 24px;">
            <div><p style="font-size: 10px; color: #64748b; margin-bottom: 4px;">{{ team1.name }}</p><p style="font-size: 36px; font-weight: 900; color: #f87171;" id="end-sets-team1">0</p></div>
            <div style="display: flex; align-items: center; color: #334155; font-size: 24px;">—</div>
            <div><p style="font-size: 10px; color: #64748b; margin-bottom: 4px;">{{ team2.name }}</p><p style="font-size: 36px; font-weight: 900; color: #60a5fa;" id="end-sets-team2">0</p></div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 10px;">
            <a href="/game/{{ game.id }}/pdf" target="_blank" style="display: block; padding: 14px; border-radius: 14px; background: rgba(167,139,250,0.15); border: 1px solid rgba(167,139,250,0.3); color: #a78bfa; font-size: 14px; font-weight: 600; text-decoration: none;">📄 Télécharger la feuille de match</a>
            <button onclick="continueMatch()" style="padding: 14px; border-radius: 14px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: #e2e8f0; font-size: 14px; font-weight: 600; cursor: pointer;">➕ Ajouter un set</button>
            <a href="{{ path('app_home') }}" style="display: block; padding: 11px; border-radius: 12px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); color: #64748b; font-size: 13px; font-weight: 600; text-decoration: none; text-align: center;">🏠 Retour à l'accueil</a>
        </div>
    </div>
</div>


{# ── MODAL MENU ── #}
<div id="modal-menu" class="modal-backdrop hidden">
    <div class="modal-card" style="text-align: center;">
        <h2 style="font-size: 17px; font-weight: 700; margin-bottom: 20px;">Menu</h2>
        <div style="display: flex; flex-direction: column; gap: 10px;">
            <a href="/game/{{ game.id }}/pdf" target="_blank" style="display: block; padding: 14px; border-radius: 14px; background: rgba(167,139,250,0.15); border: 1px solid rgba(167,139,250,0.3); color: #a78bfa; font-size: 14px; font-weight: 600; text-decoration: none;">📄 Télécharger le PDF</a>
            <button onclick="endMatch()" style="padding: 14px; border-radius: 14px; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #f87171; font-size: 14px; font-weight: 600; cursor: pointer;">🏁 Terminer le match</button>
            <button onclick="closeMenu()" style="padding: 11px; border-radius: 12px; border: none; background: rgba(255,255,255,0.03); color: #64748b; font-size: 13px; cursor: pointer;">Fermer</button>
        </div>
    </div>
</div>


<script>
    const gameId  = {{ game.id }};
    let mancheId  = {{ currentManche.id }};
    const team1Id = {{ team1.id }};
    const team2Id = {{ team2.id }};
    let serviceTeam = {{ game.serviceTeam ? game.serviceTeam.id : 'null' }};

    let courtPlayers = {
        1: [ {% for gp in team1.gamePlayers %}{% if gp.isOnCourt %}{ id: {{ gp.player.id }}, name: "{{ gp.player.name }}" },{% endif %}{% endfor %} ],
        2: [ {% for gp in team2.gamePlayers %}{% if gp.isOnCourt %}{ id: {{ gp.player.id }}, name: "{{ gp.player.name }}" },{% endif %}{% endfor %} ]
    };
    let benchPlayers = {
        1: [ {% for gp in team1.gamePlayers %}{% if not gp.isOnCourt %}{ id: {{ gp.player.id }}, name: "{{ gp.player.name }}" },{% endif %}{% endfor %} ],
        2: [ {% for gp in team2.gamePlayers %}{% if not gp.isOnCourt %}{ id: {{ gp.player.id }}, name: "{{ gp.player.name }}" },{% endif %}{% endfor %} ]
    };

    let currentTeam = null, currentType = null, subTeam = null, subPlayerOut = null;

    if (serviceTeam) updateService(serviceTeam);

    function setService(teamId) {
        fetch('/game/service', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ game_id: gameId, service_team_id: teamId }) })
        .then(r => r.json()).then(data => { serviceTeam = data.service_team_id; updateService(serviceTeam); document.getElementById('modal-service').classList.add('hidden'); });
    }

    function updateService(teamId) {
        const ball = document.getElementById('service-ball');
        const arrowLeft = document.getElementById('arrow-left');
        const arrowRight = document.getElementById('arrow-right');
        const label = document.getElementById('service-label');
        if (teamId === team1Id) {
            ball.className = 'service-ball team1-service';
            arrowLeft.style.opacity = '1'; arrowRight.style.opacity = '0';
            label.textContent = '{{ team1.name }}'; label.style.color = '#f87171';
        } else if (teamId === team2Id) {
            ball.className = 'service-ball team2-service';
            arrowLeft.style.opacity = '0'; arrowRight.style.opacity = '1';
            label.textContent = '{{ team2.name }}'; label.style.color = '#60a5fa';
        } else {
            ball.className = 'service-ball';
            arrowLeft.style.opacity = '0'; arrowRight.style.opacity = '0';
            label.textContent = '—'; label.style.color = '#475569';
        }
    }

    function openModal(teamNumber) {
        currentTeam = teamNumber; currentType = null;
        document.getElementById('step-type').classList.remove('hidden');
        document.getElementById('step-player').classList.add('hidden');
        document.getElementById('modal-title').textContent = 'Type de point';
        document.getElementById('modal-point').classList.remove('hidden');
    }
    function closeModal() { document.getElementById('modal-point').classList.add('hidden'); }

    function selectType(type) {
        currentType = type;
        if (type === 'fault') { submitPoint(null); return; }
        const list = document.getElementById('players-list');
        list.innerHTML = '';
        courtPlayers[currentTeam].forEach(p => {
            const btn = document.createElement('button');
            btn.className = 'player-btn'; btn.textContent = p.name;
            btn.onclick = () => submitPoint(p.id); list.appendChild(btn);
        });
        document.getElementById('step-type').classList.add('hidden');
        document.getElementById('step-player').classList.remove('hidden');
        document.getElementById('modal-title').textContent = 'Joueur';
    }

    function submitPoint(playerId) {
        fetch(`/game/${gameId}/add-point`, { method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ manche_id: mancheId, team_id: currentTeam === 1 ? team1Id : team2Id, player_id: playerId, type: currentType })
        }).then(r => r.json()).then(data => { closeModal(); updateScore(data); });
    }

    function updateScore(data) {
        mancheId = data.manche_id;
        document.getElementById('score-team1').textContent = data.score_team1;
        document.getElementById('score-team2').textContent = data.score_team2;
        document.getElementById('sets-team1').textContent  = data.sets_team1;
        document.getElementById('sets-team2').textContent  = data.sets_team2;
        document.getElementById('manche-number').textContent = data.manche_number;
        if (data.service_team !== serviceTeam) {
            const teamNum = data.service_team === team1Id ? 1 : 2;
            positionPlayers[teamNum].forEach(p => { p.position = (p.position - 2 + 6) % 6 + 1; });
        }
        updateService(data.service_team);
        serviceTeam = data.service_team;
        if (data.game_status === 'finished') openEndGame(data.winner_name, data.sets_team1, data.sets_team2);
    }

    function openSubstitution() {
        subTeam = null; subPlayerOut = null;
        document.getElementById('sub-step-team').classList.remove('hidden');
        document.getElementById('sub-step-out').classList.add('hidden');
        document.getElementById('sub-step-in').classList.add('hidden');
        document.getElementById('sub-title').textContent = 'Remplacement';
        document.getElementById('modal-substitution').classList.remove('hidden');
    }
    function closeSubstitution() { document.getElementById('modal-substitution').classList.add('hidden'); }

    function subSelectTeam(teamNumber) {
        subTeam = teamNumber;
        const list = document.getElementById('sub-players-out'); list.innerHTML = '';
        courtPlayers[teamNumber].forEach(p => { const btn = document.createElement('button'); btn.className = 'player-btn'; btn.textContent = p.name; btn.onclick = () => subSelectOut(p.id); list.appendChild(btn); });
        document.getElementById('sub-step-team').classList.add('hidden');
        document.getElementById('sub-step-out').classList.remove('hidden');
        document.getElementById('sub-title').textContent = 'Joueur qui sort';
    }

    function subSelectOut(playerId) {
        subPlayerOut = playerId;
        const allBench = [...benchPlayers[1], ...benchPlayers[2]];
        const list = document.getElementById('sub-players-in'); list.innerHTML = '';
        allBench.forEach(p => { const btn = document.createElement('button'); btn.className = 'player-btn'; btn.textContent = p.name; btn.onclick = () => subSelectIn(p.id); list.appendChild(btn); });
        document.getElementById('sub-step-out').classList.add('hidden');
        document.getElementById('sub-step-in').classList.remove('hidden');
        document.getElementById('sub-title').textContent = 'Joueur qui entre';
    }

    function subSelectIn(playerInId) {
        fetch(`/game/${gameId}/player/substitution`, { method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ team_id: subTeam === 1 ? team1Id : team2Id, player_out_id: subPlayerOut, player_in_id: playerInId })
        }).then(r => r.json()).then(() => {
            const teamNum = subTeam;
            const outPlayer = courtPlayers[teamNum].find(p => p.id === subPlayerOut);
            const inTeam = benchPlayers[1].find(p => p.id === playerInId) ? 1 : 2;
            const inPlayer = benchPlayers[inTeam].find(p => p.id === playerInId);
            courtPlayers[teamNum] = courtPlayers[teamNum].filter(p => p.id !== subPlayerOut);
            benchPlayers[inTeam] = benchPlayers[inTeam].filter(p => p.id !== playerInId);
            if (outPlayer) benchPlayers[teamNum].push(outPlayer);
            if (inPlayer) courtPlayers[teamNum].push(inPlayer);
            const outPosition = positionPlayers[teamNum].find(p => p.id === subPlayerOut)?.position;
            positionPlayers[teamNum] = positionPlayers[teamNum].filter(p => p.id !== subPlayerOut);
            if (inPlayer && outPosition) positionPlayers[teamNum].push({ id: inPlayer.id, name: inPlayer.name, position: outPosition });
            closeSubstitution();
        });
    }

    function rollback() {
        fetch(`/game/${gameId}/rollback`, { method: 'POST' }).then(r => r.json()).then(data => updateScore(data));
    }

    function openStats() {
        document.getElementById('layer-stats').classList.remove('hidden');
        fetch(`/game/${gameId}/stats`).then(r => r.json()).then(data => renderStats(data)).catch(err => console.error(err));
    }
    function closeStats() { document.getElementById('layer-stats').classList.add('hidden'); }

    function renderStats(data) {
        const container = document.getElementById('stats-content'); container.innerHTML = '';
        data.forEach(team => {
            const section = document.createElement('div'); section.style.cssText = 'margin-bottom: 24px;';
            const title = document.createElement('p'); title.style.cssText = 'font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #a78bfa; margin-bottom: 12px;'; title.textContent = team.team_name; section.appendChild(title);
            if (team.players.length === 0) { const empty = document.createElement('p'); empty.style.cssText = 'font-size: 12px; color: #475569; margin-bottom: 8px;'; empty.textContent = 'Aucun point marqué'; section.appendChild(empty); }
            team.players.forEach(p => {
                const row = document.createElement('div'); row.style.cssText = 'display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; border-radius: 12px; background: rgba(255,255,255,0.05); margin-bottom: 6px; border: 1px solid rgba(255,255,255,0.06);';
                const name = document.createElement('span'); name.style.cssText = 'font-size: 13px; font-weight: 600; color: #e2e8f0; min-width: 80px;'; name.textContent = p.name;
                const stats = document.createElement('div'); stats.style.cssText = 'display: flex; gap: 12px;';
                [{ label: '🎯', value: p.ace, color: '#a78bfa' }, { label: '⚡', value: p.attack, color: '#60a5fa' }, { label: '🛡️', value: p.block, color: '#34d399' }].forEach(s => {
                    const stat = document.createElement('div'); stat.style.cssText = 'display: flex; flex-direction: column; align-items: center; gap: 2px;';
                    stat.innerHTML = `<span style="font-size: 10px;">${s.label}</span><span style="font-size: 14px; font-weight: 700; color: ${s.color};">${s.value}</span>`; stats.appendChild(stat);
                });
                row.appendChild(name); row.appendChild(stats); section.appendChild(row);
            });
            const faultRow = document.createElement('div'); faultRow.style.cssText = 'display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; border-radius: 12px; background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.15); margin-top: 6px;';
            faultRow.innerHTML = `<span style="font-size: 13px; color: #f87171;">❌ Fautes adverses</span><span style="font-size: 16px; font-weight: 700; color: #f87171;">${team.faults}</span>`;
            section.appendChild(faultRow); container.appendChild(section);
        });
    }

    const positionsTeam1 = { 5: { left: '14%', top: '25%' }, 6: { left: '14%', top: '50%' }, 1: { left: '14%', top: '75%' }, 4: { left: '38%', top: '25%' }, 3: { left: '38%', top: '50%' }, 2: { left: '38%', top: '75%' } };
    const positionsTeam2 = { 2: { left: '55%', top: '25%' }, 3: { left: '55%', top: '50%' }, 4: { left: '55%', top: '75%' }, 1: { left: '79%', top: '25%' }, 6: { left: '79%', top: '50%' }, 5: { left: '79%', top: '75%' } };

    let positionPlayers = {
        1: [ {% for gp in team1.gamePlayers %}{% if gp.isOnCourt and gp.position is not null %}{ id: {{ gp.player.id }}, name: "{{ gp.player.name }}", position: {{ gp.position }} },{% endif %}{% endfor %} ],
        2: [ {% for gp in team2.gamePlayers %}{% if gp.isOnCourt and gp.position is not null %}{ id: {{ gp.player.id }}, name: "{{ gp.player.name }}", position: {{ gp.position }} },{% endif %}{% endfor %} ]
    };

    let draggedPlayer = null, draggedTeam = null;

    function openPositions() { renderPositions(); document.getElementById('modal-positions').classList.remove('hidden'); }
    function closePositions() { document.getElementById('modal-positions').classList.add('hidden'); }
    function renderPositions() { renderTeamPositions(1, 'positions-team1', positionsTeam1, '#f87171'); renderTeamPositions(2, 'positions-team2', positionsTeam2, '#60a5fa'); }

    function renderTeamPositions(teamNum, containerId, posMap, color) {
        const container = document.getElementById(containerId); container.innerHTML = '';
        positionPlayers[teamNum].forEach(p => {
            const pos = posMap[p.position]; if (!pos) return;
            const el = document.createElement('div');
            el.style.cssText = `position: absolute; left: ${pos.left}; top: ${pos.top}; transform: translate(-50%, -50%); background: ${color}; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 700; color: white; text-align: center; cursor: grab; box-shadow: 0 2px 8px rgba(0,0,0,0.4); border: 2px solid rgba(255,255,255,0.3); user-select: none; z-index: 10;`;
            el.textContent = p.name.split(' ')[0]; el.draggable = true;
            el.addEventListener('dragstart', e => { draggedPlayer = p; draggedTeam = teamNum; e.dataTransfer.effectAllowed = 'move'; });
            container.appendChild(el);
        });
        Object.entries(posMap).forEach(([pos, coords]) => {
            const zone = document.createElement('div');
            zone.style.cssText = `position: absolute; left: ${coords.left}; top: ${coords.top}; transform: translate(-50%, -50%); width: 52px; height: 52px; border-radius: 50%; border: 2px dashed rgba(255,255,255,0.2); z-index: 5;`;
            zone.addEventListener('dragover', e => { e.preventDefault(); zone.style.borderColor = 'rgba(255,255,255,0.6)'; });
            zone.addEventListener('dragleave', () => { zone.style.borderColor = 'rgba(255,255,255,0.2)'; });
            zone.addEventListener('drop', e => {
                e.preventDefault(); zone.style.borderColor = 'rgba(255,255,255,0.2)';
                if (draggedTeam !== teamNum) return;
                const targetPos = parseInt(pos); if (targetPos === draggedPlayer.position) return;
                const targetPlayer = positionPlayers[teamNum].find(p => p.position === targetPos);
                const sourcePos = draggedPlayer.position;
                draggedPlayer.position = targetPos;
                if (targetPlayer) targetPlayer.position = sourcePos;
                savePositions(teamNum); renderPositions();
            });
            container.appendChild(zone);
        });
    }

    function savePositions(teamNum) {
        fetch(`/game/${gameId}/positions`, { method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ team_id: teamNum === 1 ? team1Id : team2Id, positions: positionPlayers[teamNum].map(p => ({ player_id: p.id, position: p.position })) })
        });
    }

    function openEndGame(winnerName, setsTeam1, setsTeam2) {
        document.getElementById('end-winner-name').textContent = winnerName;
        document.getElementById('end-sets-team1').textContent = setsTeam1;
        document.getElementById('end-sets-team2').textContent = setsTeam2;
        document.getElementById('modal-end-game').classList.remove('hidden');
    }

    function continueMatch() {
        fetch(`/game/${gameId}/continue`, { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(r => r.json()).then(data => {
            mancheId = data.manche_id;
            document.getElementById('manche-number').textContent = data.manche_number;
            document.getElementById('modal-end-game').classList.add('hidden');
        });
    }

    function openMenu() { document.getElementById('modal-menu').classList.remove('hidden'); }
    function closeMenu() { document.getElementById('modal-menu').classList.add('hidden'); }

    function endMatch() {
        if (confirm('Terminer le match définitivement ?')) {
            fetch(`/game/${gameId}/end`, { method: 'POST', headers: { 'Content-Type': 'application/json' } })
            .then(r => r.json()).then(data => { closeMenu(); openEndGame(data.winner_name ?? '-', data.sets_team1, data.sets_team2); });
        }
    }
</script>

{% endblock %}