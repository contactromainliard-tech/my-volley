{% extends 'base.html.twig' %}

{% block title %}Nouveau match - MyVolley{% endblock %}

{% block body %}
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background: #050810;
        min-height: 100vh;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: #e2e8f0;
    }

    .arena-bg {
        position: fixed; inset: 0;
        background-image: url('/images/arena.png');
        background-size: cover;
        background-position: center;
        opacity: 0.15;
        z-index: 0;
    }
    .arena-overlay {
        position: fixed; inset: 0;
        background: linear-gradient(to bottom, rgba(5,8,16,0.7) 0%, rgba(5,8,16,0.5) 50%, rgba(5,8,16,0.95) 100%);
        z-index: 0;
    }

    .page-container {
        position: relative; z-index: 1;
        min-height: 100vh;
        padding: 20px 16px 40px;
        max-width: 700px;
        margin: 0 auto;
    }

    .form-input {
        width: 100%;
        padding: 12px 16px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.05);
        color: #e2e8f0;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-input::placeholder { color: #475569; }
    .form-input:focus {
        border-color: rgba(255,255,255,0.3);
        box-shadow: 0 0 0 3px rgba(255,255,255,0.05);
    }

    .team-card {
        border-radius: 20px;
        padding: 20px;
        margin-bottom: 16px;
    }
    .team-card.team1 {
        background: linear-gradient(145deg, rgba(220,38,38,0.2) 0%, rgba(127,29,29,0.1) 100%);
        border: 1px solid rgba(248,113,113,0.2);
    }
    .team-card.team2 {
        background: linear-gradient(145deg, rgba(37,99,235,0.2) 0%, rgba(29,78,216,0.1) 100%);
        border: 1px solid rgba(96,165,250,0.2);
    }

    .team1 .form-input:focus { border-color: rgba(248,113,113,0.5); box-shadow: 0 0 0 3px rgba(248,113,113,0.08); }
    .team2 .form-input:focus { border-color: rgba(96,165,250,0.5); box-shadow: 0 0 0 3px rgba(96,165,250,0.08); }

    .player-row {
        display: flex;
        gap: 8px;
        margin-bottom: 8px;
    }

    .btn-remove {
        width: 44px; height: 44px;
        border-radius: 10px;
        border: none;
        background: rgba(239,68,68,0.15);
        color: #f87171;
        font-size: 18px;
        cursor: pointer;
        flex-shrink: 0;
        transition: background 0.15s;
    }
    .btn-remove:hover { background: rgba(239,68,68,0.25); }

    .btn-add-player {
        width: 100%;
        padding: 12px;
        border-radius: 12px;
        border: 1px dashed rgba(255,255,255,0.15);
        background: none;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 8px;
        transition: all 0.15s;
    }
    .team1 .btn-add-player { border-color: rgba(248,113,113,0.3); color: #f87171; }
    .team1 .btn-add-player:hover { background: rgba(248,113,113,0.08); }
    .team2 .btn-add-player { border-color: rgba(96,165,250,0.3); color: #60a5fa; }
    .team2 .btn-add-player:hover { background: rgba(96,165,250,0.08); }
</style>

<div class="arena-bg"></div>
<div class="arena-overlay"></div>

<div class="page-container">

    {# Header #}
    <header style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 38px; height: 38px; background: radial-gradient(circle, #f87171, #dc2626); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 0 15px rgba(248,113,113,0.5);">🏐</div>
            <span style="font-size: 20px; font-weight: 900; letter-spacing: -0.5px;">My<span style="color: #60a5fa;">Volley</span></span>
        </div>
    </header>

    {# Titre #}
    <div style="margin-bottom: 28px;">
        <h2 style="font-size: 28px; font-weight: 900; margin-bottom: 6px;">Nouveau match</h2>
        <p style="font-size: 14px; color: #64748b;">Configure les équipes et leurs joueurs.</p>
    </div>

    <form method="post" action="{{ path('app_game_create') }}">

        {# Équipe 1 #}
        <div class="team-card team1">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                <div style="width: 40px; height: 40px; border-radius: 50%; background: radial-gradient(circle, rgba(248,113,113,0.3), rgba(220,38,38,0.1)); border: 2px solid rgba(248,113,113,0.4); display: flex; align-items: center; justify-content: center; font-size: 20px;">🏐</div>
                <div>
                    <p style="font-size: 11px; color: #f87171; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700;">Équipe 1</p>
                    <p style="font-size: 16px; font-weight: 800; color: #fca5a5;">Notre équipe</p>
                </div>
            </div>

            <div style="margin-bottom: 14px;">
                <label style="font-size: 12px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 6px;">Nom de l'équipe</label>
                <input type="text" id="team1_name" name="team1_name" placeholder="Ex : MVB DMA" required class="form-input">
            </div>

            <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                    <label style="font-size: 12px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.08em;">Joueurs</label>
                    <span id="team1-count" style="font-size: 12px; color: #64748b;">0 joueur</span>
                </div>
                <div id="team1-players">
                    <div class="player-row">
                        <input type="text" name="team1_players[]" placeholder="Nom et prénom du joueur" class="form-input">
                    </div>
                </div>
                <button type="button" id="add-team1-player" class="btn-add-player">+ Ajouter un joueur</button>
            </div>
        </div>

        {# Équipe 2 #}
        <div class="team-card team2">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                <div style="width: 40px; height: 40px; border-radius: 50%; background: radial-gradient(circle, rgba(96,165,250,0.3), rgba(37,99,235,0.1)); border: 2px solid rgba(96,165,250,0.4); display: flex; align-items: center; justify-content: center; font-size: 20px;">🏐</div>
                <div>
                    <p style="font-size: 11px; color: #60a5fa; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700;">Équipe 2</p>
                    <p style="font-size: 16px; font-weight: 800; color: #93c5fd;">Adversaire</p>
                </div>
            </div>

            <div style="margin-bottom: 14px;">
                <label style="font-size: 12px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 6px;">Nom de l'équipe</label>
                <input type="text" id="team2_name" name="team2_name" placeholder="Ex : La Roche-sur-Yon" required class="form-input">
            </div>

            <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                    <label style="font-size: 12px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.08em;">Joueurs</label>
                    <span id="team2-count" style="font-size: 12px; color: #64748b;">0 joueur</span>
                </div>
                <div id="team2-players">
                    <div class="player-row">
                        <input type="text" name="team2_players[]" placeholder="Nom et prénom du joueur" class="form-input">
                    </div>
                </div>
                <button type="button" id="add-team2-player" class="btn-add-player">+ Ajouter un joueur</button>
            </div>
        </div>

        {# Bouton créer #}
        <button type="submit" style="
            width: 100%;
            padding: 16px;
            border-radius: 16px;
            border: none;
            background: linear-gradient(135deg, #dc2626, #1d4ed8);
            color: white;
            font-size: 16px;
            font-weight: 800;
            cursor: pointer;
            margin-top: 8px;
            box-shadow: 0 4px 20px rgba(220,38,38,0.3), 0 4px 20px rgba(37,99,235,0.3);
            letter-spacing: 0.02em;
            transition: opacity 0.15s;
        ">
            🏐 Lancer le match →
        </button>

    </form>

</div>

<script>
    function setupPlayerList(teamNumber) {
        const container = document.getElementById(`team${teamNumber}-players`);
        const addButton = document.getElementById(`add-team${teamNumber}-player`);
        const counter   = document.getElementById(`team${teamNumber}-count`);

        function updateCounter() {
            const inputs = container.querySelectorAll('input');
            const count  = Array.from(inputs).filter(i => i.value.trim() !== '').length;
            counter.textContent = `${count} joueur${count > 1 ? 's' : ''}`;
        }

        function addPlayer() {
            const wrapper = document.createElement('div');
            wrapper.className = 'player-row';
            wrapper.innerHTML = `
                <input type="text" name="team${teamNumber}_players[]" placeholder="Nom et prénom du joueur" class="form-input">
                <button type="button" class="btn-remove">×</button>
            `;
            container.appendChild(wrapper);
            wrapper.querySelector('.btn-remove').addEventListener('click', () => { wrapper.remove(); updateCounter(); });
            wrapper.querySelector('input').addEventListener('input', updateCounter);
            wrapper.querySelector('input').focus();
            updateCounter();
        }

        addButton.addEventListener('click', addPlayer);
        container.addEventListener('input', updateCounter);
        updateCounter();
    }

    setupPlayerList(1);
    setupPlayerList(2);
</script>

{% endblock %}